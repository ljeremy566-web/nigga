[Unit]
Description=YouTube Instagram AI Oracle Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/youtube-supabase-api
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=10
Environment=NODE_ENV=production
EnvironmentFile=/home/ubuntu/youtube-supabase-api/.env.local

[Install]
WantedBy=multi-user.target
